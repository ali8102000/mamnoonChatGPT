{
  "expo": {
    "name": "ممنون",
    "slug": "kfw",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/favicon.png",
    "scheme": "mamnoon",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/favicon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f7f8f5"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mamnoon.app",
      "config": {},
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "نحتاج موقعك لعرض الخدمات القريبة وتتبع الرحلات",
        "NSCameraUsageDescription": "نحتاج الكاميرا لالتقاط صور الملف الشخصي",
        "NSPhotoLibraryUsageDescription": "نحتاج معرض الصور لاختيار صورة الملف الشخصي"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/favicon.png",
        "backgroundColor": "#f7f8f5"
      },
      "package": "com.mamnoon.app",
      "config": {},
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "VIBRATE",
        "INTERNET"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "نحتاج موقعك لعرض الخدمات القريبة وتتبع الرحلات"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "a6c763c4-3a5c-4725-b370-81967e3c0aab"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
